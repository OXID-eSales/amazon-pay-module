{% extends "page/checkout/inc/summary_sidebar.html.twig" %}

{% block basket_btn_next_bottom %}
    {{ parent() }}
    {% if oViewConf.getActiveClassName() == 'basket' and oViewConf.isAmazonActive() and not oViewConf.isAmazonExclude() and oViewConf.displayExpressInMiniCartAndModal() %}
        {% if not oViewConf.isAmazonSessionActive() %}
            {% include "@osc_amazonpay/frontend/basket_btn_next_bottom_twig" %}
        {% else %}
            {% include "@osc_amazonpay/frontend/amazonpayhint" with {withBreak: true} %}
        {% endif %}
    {% endif %}
{% endblock %}
